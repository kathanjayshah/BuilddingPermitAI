{
  "name": "building-permit-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "prisma generate && node scripts/copy-pdfjs-assets.mjs",
    "pdfjs:assets": "node scripts/copy-pdfjs-assets.mjs",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "db:migrate": "dotenv -e .env.local -e .env -- prisma migrate deploy",
    "db:migrate:dev": "dotenv -e .env.local -e .env -- prisma migrate dev",
    "db:migrate:status": "dotenv -e .env.local -e .env -- prisma migrate status",
    "db:reset": "docker compose down -v && docker compose up -d && sleep 3 && npm run db:migrate",
    "db:studio": "dotenv -e .env.local -e .env -- prisma studio",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@base-ui/react": "^1.8.0",
    "@prisma/client": "^6.19.3",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.51.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-pdf": "^11.0.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-pdf": "^6.2.0",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  }
}
