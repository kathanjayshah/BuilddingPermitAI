# App
NEXT_PUBLIC_APP_NAME=Building Permit AI

# Postgres via Colima + Compose (host 5433 -> container 5432)
DATABASE_URL=postgresql://bpa:bpa_dev_password@localhost:5433/building_permit_ai

# Local S3 via LocalStack (no real AWS account needed)
# API: http://localhost:4566
S3_ENDPOINT=http://localhost:4566
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
S3_BUCKET=bpa-permits
# Browser-reachable base URL for objects (same as endpoint for LocalStack)
S3_PUBLIC_URL=http://localhost:4566
