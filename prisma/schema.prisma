generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum NormSource {
  upload
  paste
  web_stub
  web
}

/// Stored file kind on a permit (PDF or image).
enum DocumentKind {
  pdf
  image
}

/// Common municipal / building permit categories.
enum PermitType {
  residential
  commercial
  industrial
  renovation
  demolition
  electrical
  plumbing
  mechanical
  occupancy
  zoning
  other
}

model User {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email      String      @unique
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  permits    Permit[]
  documents  Document[]
  normDocs   NormDoc[]
  reviewRuns ReviewRun[]

  @@map("users")
}

/// A permit case. File bytes live on related Document rows.
model Permit {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String      @map("user_id") @db.Uuid
  title      String
  type       PermitType  @default(other)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents  Document[]
  reviewRuns ReviewRun[]

  @@index([userId], map: "idx_permits_user_id")
  @@index([type], map: "idx_permits_type")
  @@index([createdAt(sort: Desc)], map: "idx_permits_created_at")
  @@map("permits")
}

/// Uploaded PDF or image belonging to a permit.
model Document {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  permitId   String       @map("permit_id") @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  kind       DocumentKind
  fileName   String       @map("file_name")
  fileSize   BigInt       @map("file_size")
  mimeType   String       @map("mime_type")
  storageKey String       @map("storage_key")
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  permit     Permit       @relation(fields: [permitId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([permitId], map: "idx_documents_permit_id")
  @@index([userId], map: "idx_documents_user_id")
  @@index([createdAt(sort: Desc)], map: "idx_documents_created_at")
  @@map("documents")
}

model NormDoc {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String          @map("user_id") @db.Uuid
  title      String
  source     NormSource
  content    String          @default("")
  fileName   String?         @map("file_name")
  sourceUrl  String?         @map("source_url")
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewRuns ReviewRunNorm[]

  @@index([userId], map: "idx_norm_docs_user_id")
  @@index([createdAt(sort: Desc)], map: "idx_norm_docs_created_at")
  @@map("norm_docs")
}

model ReviewRun {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String          @map("user_id") @db.Uuid
  permitId  String          @map("permit_id") @db.Uuid
  status    String          @default("queued")
  note      String?
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  permit    Permit          @relation(fields: [permitId], references: [id], onDelete: Cascade)
  norms     ReviewRunNorm[]

  @@index([userId], map: "idx_review_runs_user_id")
  @@index([permitId], map: "idx_review_runs_permit_id")
  @@index([createdAt(sort: Desc)], map: "idx_review_runs_created_at")
  @@map("review_runs")
}

model ReviewRunNorm {
  reviewRunId String    @map("review_run_id") @db.Uuid
  normDocId   String    @map("norm_doc_id") @db.Uuid
  reviewRun   ReviewRun @relation(fields: [reviewRunId], references: [id], onDelete: Cascade)
  normDoc     NormDoc   @relation(fields: [normDocId], references: [id], onDelete: Cascade)

  @@id([reviewRunId, normDocId])
  @@index([normDocId], map: "idx_review_run_norms_norm_doc_id")
  @@map("review_run_norms")
}
